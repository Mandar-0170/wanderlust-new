{
  "title": "Custom Prometheus Kubernetes Overview",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Targets Up",
      "targets": [
        {
          "expr": "sum(up)",
          "legendFormat": "Targets Up"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Targets Down",
      "targets": [
        {
          "expr": "count(up) - sum(up)",
          "legendFormat": "Targets Down"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      }
    },
    {
      "type": "graph",
      "title": "Scrape Duration",
      "targets": [
        {
          "expr": "scrape_duration_seconds",
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "graph",
      "title": "Scrape Samples",
      "targets": [
        {
          "expr": "scrape_samples_scraped",
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "table",
      "title": "Targets Status",
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      }
    }
  ]
}